            },
            {
              "name": "中虚线",
              "lineweight": "=0.5b",
              "linetype": "DASHED"
            },
            {
              "name": "细单点长画线",
              "lineweight": "=0.25b",
              "linetype": "CENTER"
            },
            {
              "name": "细双点长画线",
              "lineweight": "=0.25b",
              "linetype": "PHANTOM"
            }
          ]
        }
      },
