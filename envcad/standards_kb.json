    "Line": [
      {
        "dim": "Line",
        "std": "GB/T 50001-2017",
        "clause": "4.0.1",
        "industry": [
          "building"
        ],
        "name": "线宽组",
        "verified": true,
        "source": "https://gf.cabr-fire.com/article-45597.htm",
        "param": {
          "b_series_mm": [
            1.4,
            1.0,
            0.7,
            0.5
          ],
          "width_groups_mm": {
            "1.4": [
              1.4,
              1.0,
              0.7,
              0.35
            ],
            "1.0": [
              1.0,
              0.7,
              0.5,
              0.25
            ],
            "0.7": [
              0.7,
              0.5,
              0.35,
              0.18
            ],
            "0.5": [
              0.5,
              0.35,
              0.25,
              0.13
            ]
          },
          "group_order": [
            "b",
            "0.7b",
            "0.5b",
            "0.25b"
          ],
          "minWidth_mm": 0.1,
          "note": "★ 2017 版修正：b 只从 1.4/1.0/0.7/0.5 中选取，取消了 0.35/0.25/0.18/0.13 作为基本线宽 b。旧版知识库把 b 系列写成 {2.0,1.4,1.0,0.7,0.5,0.35} 是错的（b 无 2.0；0.35 是 0.7b/0.5b 而非 b）。0.25b 一栏可取 0.13。图线宽度不应小于 0.1mm（§4.0.1 条文说明）。"
        },
        "cadExec": {
          "tool": "buildLineLayers",
          "layers": [
            {
              "name": "粗实线",
              "lineweight": "=b",
              "linetype": "Continuous"
            },
            {
              "name": "中实线",
              "lineweight": "=0.5b",
              "linetype": "Continuous"
            },
            {
              "name": "细实线",
              "lineweight": "=0.25b",
